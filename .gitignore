# Dependencies
node_modules/

# Local runtime data: accounts, session secret, chats
server-data/
**/.zaalis/

# Environment and secrets
.env
.env.*
*.pem
*.key

# Generated native builds and installers
native/dist/
native/installer/
!native/installer/
!native/installer/zaalis-setup.exe
native/packages/*.zip
# Third-party tunnel binary (vendored locally; already bundled in the installer)
native/cloudflared.exe

# Local tooling / unrelated checkouts (never ship in the product repo)
.claude/
claude-code-main/

# Logs and caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
.tmp/
tmp/
temp/

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
